# Postgres connection string (docker-compose maps the container's 5432 to host 5433,
# to avoid colliding with any other local Postgres already listening on 5432)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/leaddiscovery

# LLM provider (Groq free tier: https://console.groq.com — OpenAI-compatible API)
GROQ_API_KEY=your-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# Optional: if you have a search API key (Serper.dev has a free trial), it gives
# much better discovery results than the free HTML fallback. Leave blank to use
# the built-in DuckDuckGo HTML fallback (no key required).
SERPER_API_KEY=

PORT=4000
